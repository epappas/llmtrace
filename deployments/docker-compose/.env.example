# Core images
VERSION=latest
PROXY_IMAGE=ghcr.io/epappas/llmtrace-proxy:${VERSION}

# Public endpoints
PUBLIC_BASE_URL=https://llmtrace.example.com
NEXT_PUBLIC_API_URL=https://llmtrace.example.com
TLS_CERT_PATH=./nginx/certs/tls.crt
TLS_KEY_PATH=./nginx/certs/tls.key

# Backing services
CLICKHOUSE_DATABASE=llmtrace
POSTGRES_USER=llmtrace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llmtrace
REDIS_PASSWORD=

# Proxy runtime
LLMTRACE_CONFIG=/etc/llmtrace/config.yaml
LLMTRACE_CLICKHOUSE_URL=http://clickhouse:8123
LLMTRACE_CLICKHOUSE_DATABASE=llmtrace
LLMTRACE_POSTGRES_URL=postgres://llmtrace:change-me@postgres:5432/llmtrace
LLMTRACE_REDIS_URL=redis://redis:6379
LLMTRACE_ML_ENABLED=1
LLMTRACE_ML_PRELOAD=1
LLMTRACE_ML_CACHE_DIR=/home/llmtrace/.cache/llmtrace/models
RUST_LOG=info

# Optional auth/bootstrap secrets
LLMTRACE_AUTH_ADMIN_KEY=

# Dashboard
HOSTNAME=0.0.0.0
DASHBOARD_PORT=3000

# Monitoring
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
